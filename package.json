{
  "name": "shellcheck-wasm",
  "version": "0.1.0",
  "type": "module",
  "description": "ShellCheck compiled to WebAssembly with TypeScript API",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && npm run build:wasm && npm run copy:wasm && npm run gen:types",
    "build:wasm": "bash scripts/build-wasm.sh",
    "copy:wasm": "tsx scripts/copy-wasm.ts",
    "gen:types": "tsx scripts/gen-types.ts",
    "test": "vitest run",
    "test:node": "vitest run --pool=forks src/__tests__/node.test.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^20.14.0",
    "@vitest/browser": "^2.1.9",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "playwright": "^1.63.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["shellcheck", "wasm", "webassembly", "linter", "shell", "bash"],
  "author": "",
  "license": "GPL-3.0-or-later"
}
